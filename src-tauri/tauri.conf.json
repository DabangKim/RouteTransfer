{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RouteTransfer",
  "version": "0.1.0",
  "identifier": "app.routetransfer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RouteTransfer",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": [] }
}
